{
  "opencollection": "1.0.0",
  "info": {
    "name": "Preset Authentication SQL Lab API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "SQL Lab",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Execute a SQL query (Superset proxy)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.app.preset.io/api/v1/sqllab/execute/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Per-workspace proxy to the Apache Superset SQL Lab execute endpoint. Runs an ad hoc SQL query against a connected database and returns the result set or an async query id."
        }
      ]
    }
  ],
  "bundled": true
}