          "request": {
            "name": "Execute a SQL query (Superset proxy)",
            "description": {
              "content": "Per-workspace proxy to the Apache Superset SQL Lab execute endpoint. Runs an ad hoc SQL query against a connected database and returns the result set or an async query id.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "api",
                "v1",
                "sqllab",
                "execute",
                ""
              ],
